<?xml version="1.0"?>
<psalm
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    findUnusedBaselineEntry="false"
    findUnusedPsalmSuppress="false"
    findUnusedCode="false"
    findUnusedVariablesAndParams="false"
    phpVersion="8.1"
    errorLevel="1"
>
    <projectFiles>
        <directory name="src"/>
        <directory name="tests"/>
        <ignoreFiles>
            <directory name="tests/Application"/>
            <directory name="vendor"/>
        </ignoreFiles>
    </projectFiles>
    <plugins>
        <pluginClass class="Psalm\PhpUnitPlugin\Plugin"/>
        <pluginClass class="Psalm\SymfonyPsalmPlugin\Plugin"/>
    </plugins>
    <forbiddenFunctions>
        <function name="dd"/>
        <function name="dump"/>
        <function name="exit"/>
        <function name="var_dump"/>
        <function name="print_r"/>
    </forbiddenFunctions>
    <issueHandlers>
        <ClassMustBeFinal>
            <errorLevel type="suppress">
                <directory name="src/Fixture"/>
                <directory name="src/Model"/>
                <directory name="src/Repository"/>
            </errorLevel>
        </ClassMustBeFinal>
        <InvalidArgument>
            <errorLevel type="suppress">
                <directory name="src/Fixture"/>
                <directory name="tests/Fixture"/>
            </errorLevel>
        </InvalidArgument>
        <PluginIssue name="QueryBuilderSetParameter" errorLevel="suppress"/>
        <PropertyNotSetInConstructor>
            <errorLevel type="suppress">
                <directory name="src/Model"/>
            </errorLevel>
        </PropertyNotSetInConstructor>
        <MissingTemplateParam>
            <errorLevel type="suppress">
                <directory name="src/Factory"/>
                <directory name="src/Form"/>
                <directory name="src/Repository"/>
            </errorLevel>
        </MissingTemplateParam>
        <MixedArgument>
            <errorLevel type="suppress">
                <directory name="src/Fixture"/>
            </errorLevel>
        </MixedArgument>
        <MixedMethodCall>
            <errorLevel type="suppress">
                <directory name="tests"/>
            </errorLevel>
        </MixedMethodCall>
        <MixedReturnStatement>
            <errorLevel type="suppress">
                <directory name="src/Fixture"/>
            </errorLevel>
        </MixedReturnStatement>
        <MixedArgumentTypeCoercion>
            <errorLevel type="suppress">
                <directory name="src/Fixture"/>
            </errorLevel>
        </MixedArgumentTypeCoercion>
        <MissingClassConstType errorLevel="suppress"/>
        <MissingOverrideAttribute errorLevel="suppress"/>
        <UndefinedMagicMethod>
            <errorLevel type="suppress">
                <directory name="tests"/>
            </errorLevel>
        </UndefinedMagicMethod>
    </issueHandlers>
</psalm>
