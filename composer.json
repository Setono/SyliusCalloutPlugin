{
    "name": "setono/sylius-callout-plugin",
    "description": "Add callouts/badges to your Sylius products",
    "license": "MIT",
    "type": "sylius-plugin",
    "keywords": [
        "sylius",
        "sylius-plugin",
        "setono",
        "callout"
    ],
    "require": {
        "php": ">=8.2",
        "doctrine/collections": "^2.0",
        "doctrine/dbal": "^3.0",
        "doctrine/orm": "^2.18 || ^3.3",
        "doctrine/persistence": "^2.5 || ^3.2",
        "fakerphp/faker": "^1.24",
        "ocramius/doctrine-batch-utils": "^2.4",
        "psr/event-dispatcher": "^1.0",
        "setono/composite-compiler-pass": "^1.2",
        "setono/doctrine-orm-trait": "^1.2",
        "sylius/admin-bundle": "^2.0",
        "sylius/channel": "^2.0",
        "sylius/channel-bundle": "^2.0",
        "sylius/core": "^2.0",
        "sylius/core-bundle": "^2.0",
        "sylius/grid-bundle": "^1.13",
        "sylius/locale": "^2.0",
        "sylius/product": "^2.0",
        "sylius/registry": "^1.6",
        "sylius/resource-bundle": "^1.13",
        "sylius/taxonomy": "^2.0",
        "sylius/taxonomy-bundle": "^2.0",
        "sylius/ui-bundle": "^2.0",
        "symfony/config": "^6.4 || ^7.3",
        "symfony/console": "^6.4 || ^7.3",
        "symfony/dependency-injection": "^6.4 || ^7.3",
        "symfony/event-dispatcher": "^6.4 || ^7.3",
        "symfony/form": "^6.4 || ^7.3",
        "symfony/messenger": "^6.4 || ^7.3",
        "symfony/options-resolver": "^6.4 || ^7.3",
        "symfony/twig-bundle": "^6.4 || ^7.3",
        "symfony/ux-live-component": "^2.27",
        "symfony/validator": "^6.4 || ^7.3",
        "twig/twig": "^2.15 || ^3.8",
        "webmozart/assert": "^1.11"
    },
    "require-dev": {
        "api-platform/metadata": "^4.1.18",
        "api-platform/symfony": "^4.1.10",
        "infection/infection": "^0.29.14",
        "matthiasnoback/symfony-dependency-injection-test": "^6.1",
        "payum/core": "^1.7.6",
        "phpspec/prophecy-phpunit": "^2.4",
        "phpunit/phpunit": "^10.5.46",
        "psalm/plugin-phpunit": "^0.19.5",
        "psalm/plugin-symfony": "^5.2",
        "setono/code-quality-pack": "^2.10",
        "shipmonk/composer-dependency-analyser": "^1.8.3",
        "sylius/sylius": "~2.0.10",
        "symfony/debug-bundle": "^6.4 || ^7.3",
        "symfony/dotenv": "^6.4 || ^7.3",
        "symfony/intl": "^6.4 || ^7.3",
        "symfony/property-info": "^6.4 || ^7.3",
        "symfony/serializer": "^6.4 || ^7.3",
        "symfony/web-profiler-bundle": "^6.4 || ^7.3",
        "symfony/webpack-encore-bundle": "^2.2"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Setono\\SyliusCalloutPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Setono\\SyliusCalloutPlugin\\Tests\\": "tests/"
        },
        "classmap": [
            "tests/Application/Kernel.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": false,
            "php-http/discovery": false,
            "symfony/thanks": false
        },
        "sort-packages": true
    },
    "scripts": {
        "analyse": "psalm",
        "check-style": "ecs check",
        "fix-style": "ecs check --fix",
        "phpunit": "phpunit"
    }
}
